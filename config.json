<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PROMO Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root {
  --bg:#080B0F; --surface:#0E1318; --surface2:#141B22; --surface3:#1A2330;
  --border:rgba(255,255,255,0.06); --border2:rgba(255,255,255,0.1);
  --text:#E2EAF0; --muted:#5A6A78; --muted2:#8A9BAA;
  --green:#00E5A0; --green-dim:rgba(0,229,160,0.12);
  --red:#FF3D5A; --red-dim:rgba(255,61,90,0.12);
  --blue:#4D9FFF; --blue-dim:rgba(77,159,255,0.12);
  --amber:#FFB020; --amber-dim:rgba(255,176,32,0.12);
  --purple:#A78BFA; --purple-dim:rgba(167,139,250,0.12);
}
*{box-sizing:border-box;margin:0;padding:0;}
html{font-size:18px;}
body{background:var(--bg);color:var(--text);font-family:Arial,sans-serif;min-height:100vh;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(77,159,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(77,159,255,0.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;}
.app{position:relative;z-index:1;max-width:1600px;margin:0 auto;padding:2.5rem;}

/* Header */
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
.logo{display:flex;align-items:center;gap:16px;}
.logo-mark{width:52px;height:52px;background:linear-gradient(135deg,#4D9FFF,#00E5A0);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#080B0F;}
.logo h1{font-size:1.8rem;font-weight:800;letter-spacing:-0.02em;}
.logo h1 span{color:var(--blue);}
.logo p{font-size:0.75rem;color:var(--muted);margin-top:3px;}
.header-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.status-chip{display:flex;align-items:center;gap:7px;padding:8px 16px;background:var(--surface2);border:1px solid var(--border2);border-radius:20px;font-size:0.78rem;color:var(--muted2);}
.dot{width:8px;height:8px;border-radius:50%;background:var(--muted);}
.dot.live{background:var(--green);box-shadow:0 0 6px var(--green);animation:blink 2s infinite;}
.dot.error{background:var(--red);}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.4}}

/* Nav */
.nav{display:flex;gap:4px;margin-bottom:2rem;background:var(--surface2);border-radius:12px;padding:4px;width:fit-content;flex-wrap:wrap;}
.nav-tab{padding:10px 20px;border-radius:9px;font-size:0.85rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--muted2);transition:all 0.15s;font-family:Arial,sans-serif;}
.nav-tab.active{background:var(--blue);color:#080B0F;}

/* Upload section */
.upload-bar{display:flex;align-items:center;gap:10px;padding:1rem 1.4rem;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:1.5rem;flex-wrap:wrap;}
.upload-bar-title{font-size:0.78rem;color:var(--muted2);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin-right:8px;}
.upload-bar-sep{width:1px;height:28px;background:var(--border2);margin:0 4px;}
.upload-btn{display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-size:0.78rem;cursor:pointer;font-family:Arial,sans-serif;transition:all 0.15s;}
.upload-btn:hover{border-color:var(--blue);color:var(--blue);}
.upload-btn.uploading{opacity:0.6;cursor:wait;}
.upload-btn.done{border-color:var(--green);color:var(--green);}
.upload-btn.done-dep{border-color:var(--amber);color:var(--amber);}
.upload-btn.done-wd{border-color:var(--purple);color:var(--purple);}
.upload-btn input{display:none;}
.ppt-btn{display:flex;align-items:center;gap:8px;padding:8px 16px;border-radius:8px;border:none;background:linear-gradient(135deg,#E63946,#C1121F);color:#fff;font-size:0.78rem;font-weight:700;cursor:pointer;font-family:Arial,sans-serif;margin-left:auto;}
.ppt-btn:hover{opacity:0.85;}
.ppt-btn:disabled{opacity:0.4;cursor:not-allowed;}

/* Controls */
.controls{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:10px;}
.tabs{display:flex;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:3px;gap:2px;}
.tab{padding:8px 20px;border-radius:7px;font-size:0.85rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--muted2);transition:all 0.15s;font-family:Arial,sans-serif;}
.tab.active{background:var(--blue);color:#080B0F;}
.filter-wrap{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.date-input{font-size:0.8rem;padding:8px 12px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-family:Arial,sans-serif;}
.date-sep{color:var(--muted);font-size:0.8rem;}
.date-reset{font-size:0.78rem;padding:8px 12px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--muted2);cursor:pointer;font-family:Arial,sans-serif;}
.date-reset:hover{background:var(--surface2);}
.sel{font-size:0.8rem;padding:8px 12px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-family:Arial,sans-serif;min-width:140px;}

/* Currency sections */
.currency-section{margin-bottom:1.5rem;}
.currency-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;padding:10px 16px;border-radius:10px;}
.currency-header.myr{background:rgba(77,159,255,0.08);border:1px solid rgba(77,159,255,0.2);}
.currency-header.sgd{background:rgba(0,229,160,0.08);border:1px solid rgba(0,229,160,0.2);}
.currency-label{font-size:1rem;font-weight:700;}
.currency-label.myr{color:var(--blue);}
.currency-label.sgd{color:var(--green);}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.5rem;}
.metric{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;position:relative;overflow:hidden;}
.metric::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.metric.myr-card::after{background:var(--blue);}
.metric.sgd-card::after{background:var(--green);}
.metric .lbl{font-size:0.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;}
.metric .val{font-size:1.8rem;font-weight:700;letter-spacing:-0.02em;line-height:1;}
.metric .val.myr-val{color:var(--blue);}
.metric .val.sgd-val{color:var(--green);}
.metric .sub{font-size:0.7rem;color:var(--muted);margin-top:6px;}

/* Charts */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;}
.chart-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;}
.chart-title{font-size:0.75rem;color:var(--muted2);text-transform:uppercase;letter-spacing:0.08em;}
.legend{display:flex;gap:14px;flex-wrap:wrap;}
.legend span{display:flex;align-items:center;gap:5px;font-size:0.72rem;color:var(--muted2);}
.leg{width:9px;height:9px;border-radius:2px;flex-shrink:0;}
.chart-wrap{position:relative;width:100%;height:240px;}
.divider{border:none;border-top:1px solid var(--border);margin:1.5rem 0;}

/* Table */
.table-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:14px;}
.table-hd{padding:1.1rem 1.4rem;border-bottom:1px solid var(--border);font-size:0.75rem;color:var(--muted2);text-transform:uppercase;letter-spacing:0.08em;}
.table-wrap{overflow-x:auto;max-height:500px;overflow-y:auto;}
table{width:100%;border-collapse:collapse;}
th{font-size:0.72rem;color:var(--muted);font-weight:400;text-align:right;padding:10px 12px;border-bottom:1px solid var(--border);white-space:nowrap;text-transform:uppercase;position:sticky;top:0;background:var(--surface);}
th:first-child,th:nth-child(2),th:nth-child(3){text-align:left;}
td{padding:10px 12px;border-bottom:1px solid var(--border);text-align:right;font-size:0.82rem;white-space:nowrap;color:var(--muted2);}
td:first-child{text-align:left;color:var(--muted);font-size:0.75rem;}
td:nth-child(2),td:nth-child(3){text-align:left;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(255,255,255,0.02);}
.type-tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:0.7rem;background:var(--blue-dim);color:var(--blue);}
.myr-v{color:var(--blue);}
.sgd-v{color:var(--green);}

/* Analysis page */
.analysis-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:1.5rem;}
.analysis-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.analysis-card-header{padding:12px 16px;font-size:0.85rem;font-weight:700;display:flex;align-items:center;gap:8px;}
.analysis-card-header.green{background:var(--green-dim);color:var(--green);}
.analysis-card-header.red{background:var(--red-dim);color:var(--red);}
.analysis-card-header.amber{background:var(--amber-dim);color:var(--amber);}
.analysis-item{padding:10px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;}
.analysis-item:last-child{border-bottom:none;}
.analysis-item-name{font-size:0.82rem;color:var(--text);flex:1;}
.analysis-item-profit{font-size:0.82rem;font-weight:700;white-space:nowrap;}
.analysis-item-stats{font-size:0.72rem;color:var(--muted);text-align:right;}
.cur-toggle{display:flex;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:3px;gap:2px;margin-bottom:1.5rem;width:fit-content;}
.cur-tab{padding:7px 20px;border-radius:7px;font-size:0.82rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--muted2);transition:all 0.15s;font-family:Arial,sans-serif;}
.cur-tab.active{background:var(--blue);color:#080B0F;}
.analysis-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.5rem;}

/* Player page */
.player-search{display:flex;gap:10px;margin-bottom:1.5rem;}
.player-input{flex:1;padding:12px 16px;border-radius:10px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-size:0.9rem;font-family:Arial,sans-serif;}
.player-input:focus{outline:none;border-color:var(--blue);}
.search-btn{padding:12px 20px;border-radius:10px;border:none;background:var(--blue);color:#080B0F;font-size:0.9rem;font-weight:700;cursor:pointer;font-family:Arial,sans-serif;}
.search-btn:hover{opacity:0.85;}
.player-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;margin-bottom:14px;}
.player-name{font-size:1.4rem;font-weight:800;margin-bottom:0.5rem;}
.player-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:1.4rem;}
.player-stat{background:var(--surface2);border-radius:10px;padding:1rem;text-align:center;}
.player-stat .lbl{font-size:0.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;}
.player-stat .val{font-size:1.2rem;font-weight:700;}
.promo-category{background:var(--surface2);border-radius:12px;overflow:hidden;margin-bottom:8px;}
.promo-category-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;cursor:pointer;transition:background 0.15s;}
.promo-category-header:hover{background:var(--surface3);}
.pch-left{display:flex;align-items:center;gap:12px;}
.pch-name{font-size:0.9rem;font-weight:700;color:var(--text);}
.pch-count{font-size:0.72rem;color:var(--muted);background:var(--surface3);padding:2px 8px;border-radius:10px;}
.pch-right{display:flex;align-items:center;gap:16px;}
.pch-stat{text-align:right;}
.pch-stat .lbl{font-size:0.65rem;color:var(--muted);text-transform:uppercase;}
.pch-stat .val{font-size:0.82rem;font-weight:700;}
.pch-arrow{color:var(--muted);font-size:0.85rem;transition:transform 0.2s;}
.pch-arrow.open{transform:rotate(180deg);}
.promo-category-table{display:none;border-top:1px solid var(--border);}
.promo-category-table.open{display:block;}
.promo-category-table table{width:100%;border-collapse:collapse;}
.promo-category-table th{font-size:0.7rem;color:var(--muted);font-weight:400;text-align:right;padding:8px 14px;border-bottom:1px solid var(--border);text-transform:uppercase;background:var(--surface);}
.promo-category-table th:first-child{text-align:left;}
.promo-category-table td{padding:9px 14px;border-bottom:1px solid var(--border);text-align:right;font-size:0.82rem;color:var(--muted2);}
.promo-category-table td:first-child{text-align:left;color:var(--muted);}
.promo-category-table tr:last-child td{border-bottom:none;}
.promo-category-table tr:hover td{background:rgba(255,255,255,0.02);}

/* ── Timeline ── */
.timeline-section{margin-top:1.5rem;}
.timeline-title{font-size:0.75rem;color:var(--muted2);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border);}
.timeline{position:relative;padding-left:28px;}
.timeline::before{content:'';position:absolute;left:10px;top:0;bottom:0;width:2px;background:var(--border2);}
.tl-item{position:relative;margin-bottom:10px;}
.tl-dot{position:absolute;left:-22px;top:12px;width:12px;height:12px;border-radius:50%;border:2px solid;}
.tl-dot.deposit{background:rgba(77,159,255,0.3);border-color:var(--blue);}
.tl-dot.bonus{background:rgba(255,176,32,0.3);border-color:var(--amber);}
.tl-dot.withdraw{background:rgba(255,61,90,0.3);border-color:var(--red);}
.tl-card{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.tl-card:hover{border-color:var(--border2);}
.tl-left{display:flex;align-items:center;gap:10px;}
.tl-badge{font-size:0.68rem;font-weight:700;padding:3px 8px;border-radius:5px;white-space:nowrap;}
.tl-badge.deposit{background:var(--blue-dim);color:var(--blue);}
.tl-badge.bonus{background:var(--amber-dim);color:var(--amber);}
.tl-badge.withdraw{background:var(--red-dim);color:var(--red);}
.tl-time{font-size:0.72rem;color:var(--muted);}
.tl-desc{font-size:0.78rem;color:var(--muted2);}
.tl-amount{font-size:0.88rem;font-weight:700;white-space:nowrap;}
.tl-amount.deposit{color:var(--blue);}
.tl-amount.bonus{color:var(--amber);}
.tl-amount.withdraw{color:var(--red);}
.tl-gap{display:inline-block;margin:4px 0 4px 0;padding:3px 10px;border-radius:5px;font-size:0.7rem;color:var(--muted);background:var(--surface3);border:1px dashed var(--border2);}
.timeline-empty{padding:1.2rem;text-align:center;color:var(--muted);font-size:0.82rem;background:var(--surface2);border-radius:10px;}
.tl-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.2rem;}
.tl-sum-card{background:var(--surface2);border-radius:10px;padding:0.9rem;text-align:center;}
.tl-sum-card .lbl{font-size:0.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:5px;}
.tl-sum-card .val{font-size:1rem;font-weight:700;}

/* Builder */
.builder-layout{display:grid;grid-template-columns:280px 1fr;gap:14px;align-items:start;}
.builder-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;position:sticky;top:1rem;}
.builder-panel h3{font-size:0.85rem;font-weight:700;margin-bottom:1.25rem;}
.field-group{margin-bottom:1.25rem;}
.field-group label{display:block;font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;}
.field-group select,.field-group input[type=date]{width:100%;font-size:0.82rem;padding:9px 12px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-family:Arial,sans-serif;}
.multi-select{display:flex;flex-direction:column;gap:6px;max-height:160px;overflow-y:auto;}
.multi-select label{display:flex;align-items:center;gap:8px;font-size:0.8rem;color:var(--text);text-transform:none;letter-spacing:0;cursor:pointer;padding:5px 8px;border-radius:6px;}
.multi-select label:hover{background:var(--surface2);}
.multi-select input[type=checkbox]{accent-color:var(--blue);width:15px;height:15px;}
.chart-type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;}
.ct-btn{padding:10px 6px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--muted2);cursor:pointer;font-size:0.7rem;font-family:Arial,sans-serif;text-align:center;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px;}
.ct-btn:hover,.ct-btn.active{border-color:var(--blue);background:var(--blue-dim);color:var(--blue);font-weight:700;}
.ct-icon{font-size:1.2rem;}
.build-btn{width:100%;padding:12px;border-radius:10px;border:none;background:var(--blue);color:#080B0F;font-size:0.88rem;font-weight:700;cursor:pointer;font-family:Arial,sans-serif;margin-top:0.5rem;}
.builder-output{display:flex;flex-direction:column;gap:14px;}
.built-chart-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;}
.built-chart-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;}
.built-chart-title{font-size:0.9rem;font-weight:700;}
.remove-btn{border:none;background:transparent;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:0 4px;}
.remove-btn:hover{color:var(--red);}
.empty-builder{display:flex;flex-direction:column;align-items:center;justify-content:center;height:300px;color:var(--muted);font-size:0.85rem;gap:1rem;background:var(--surface);border:1px solid var(--border);border-radius:14px;}
.empty-icon{font-size:3rem;opacity:0.3;}

.loading-state{display:flex;align-items:center;justify-content:center;height:200px;color:var(--muted);font-size:0.85rem;gap:10px;}
.spinner{width:20px;height:20px;border:2px solid var(--border2);border-top-color:var(--blue);border-radius:50%;animation:spin 0.8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.hidden{display:none!important;}

/* Comparison page */
.comparison-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:1.5rem;}
.comparison-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem;}
.comparison-header{font-size:0.75rem;color:var(--muted2);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1rem;}
.comparison-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);}
.comparison-row:last-child{border-bottom:none;}
.comparison-label{font-size:0.82rem;color:var(--muted2);}
.comparison-vals{display:flex;gap:16px;align-items:center;}
.comparison-val{font-size:0.85rem;font-weight:700;text-align:right;min-width:100px;}
.comparison-change{font-size:0.75rem;font-weight:700;padding:2px 7px;border-radius:5px;}
.change-up{background:var(--green-dim);color:var(--green);}
.change-down{background:var(--red-dim);color:var(--red);}
.change-flat{background:var(--border);color:var(--muted);}
.month-tabs{display:flex;gap:8px;margin-bottom:1.5rem;flex-wrap:wrap;}
.month-tab{padding:7px 14px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--muted2);font-size:0.78rem;cursor:pointer;font-family:Arial,sans-serif;}
.month-tab.active{border-color:var(--blue);color:var(--blue);background:var(--blue-dim);}

/* Provider page */
.provider-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:1.5rem;}

/* ── Daily Mission ── */
:root { --teal:#00C9FF; --teal-dim:rgba(0,201,255,0.12); }
.mission-kpi{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:1.5rem;}
.metric.teal-card::after{background:var(--teal);}
.metric .val.teal-val{color:var(--teal);}
.mission-funnel{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:14px;}
.mission-funnel-hd{padding:1rem 1.4rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.mission-funnel-title{font-size:0.75rem;color:var(--muted2);text-transform:uppercase;letter-spacing:0.08em;}
.mission-day-row{display:grid;grid-template-columns:80px 1fr 1fr 100px 110px 110px;align-items:center;gap:12px;padding:10px 1.4rem;border-bottom:1px solid var(--border);}
.mission-day-row:last-child{border-bottom:none;}
.mission-day-row:hover{background:rgba(255,255,255,0.02);}
.mission-day-label{font-size:0.82rem;font-weight:700;color:var(--teal);}
.mission-bar-wrap{position:relative;height:20px;background:var(--surface3);border-radius:4px;overflow:hidden;}
.mission-bar-claimed{position:absolute;left:0;top:0;height:100%;background:var(--teal);border-radius:4px;}
.mission-bar-expired{position:absolute;top:0;height:100%;background:var(--red);opacity:0.7;}
.mission-bar-label{font-size:0.7rem;color:var(--muted2);white-space:nowrap;}
.mission-stat-cell{text-align:right;font-size:0.78rem;color:var(--muted2);}
.mission-group-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:1.5rem;}
.mission-group-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1rem;text-align:center;}
.mission-group-name{font-size:0.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;}
.mission-group-val{font-size:1.4rem;font-weight:700;}
.mission-group-sub{font-size:0.7rem;color:var(--muted);margin-top:4px;}
.provider-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.2rem;cursor:pointer;transition:border-color 0.15s;}
.provider-card:hover{border-color:var(--blue);}
.provider-card.active{border-color:var(--blue);background:var(--blue-dim);}
.provider-name{font-size:0.85rem;font-weight:700;margin-bottom:8px;}
.provider-stats{display:flex;gap:10px;flex-wrap:wrap;}
.provider-stat{font-size:0.72rem;color:var(--muted2);}
</style>
</head>
<body>
<div class="app">

<div class="header">
  <div class="logo">
    <div class="logo-mark">P</div>
    <div>
      <h1>PROMO <span>Dashboard</span></h1>
      <p>MYR & SGD  |  实时数据分析</p>
    </div>
  </div>
  <div class="header-right">
    <button class="ppt-btn" id="pptBtn" onclick="generateReport()" disabled>📊 生成报告</button>
    <div class="status-chip">
      <div class="dot" id="statusDot"></div>
      <span id="statusText">加载中...</span>
    </div>
  </div>
</div>

<!-- Upload Bar (dynamically built from config.json) -->
<div class="upload-bar" id="uploadBar">
  <span class="upload-bar-title">上传数据</span>
</div>

<!-- Nav -->
<div class="nav" id="mainNav">
  <button class="nav-tab active" onclick="switchPage('overview',this)">📊 总览</button>
  <button class="nav-tab" onclick="switchPage('analysis',this)">🔍 Promo 分析</button>
  <button class="nav-tab" onclick="switchPage('player',this)">👤 玩家行为</button>
  <button class="nav-tab" onclick="switchPage('comparison',this)">📅 月份对比</button>
  <button class="nav-tab" onclick="switchPage('provider',this)">🎮 供应商分析</button>
  <button class="nav-tab" onclick="switchPage('builder',this)">🎨 图表构建器</button>
  <button class="nav-tab" onclick="switchPage('mission',this)">🎯 Daily Mission</button>
</div>

<!-- ── OVERVIEW PAGE ── -->
<div id="overviewPage">
  <div class="controls">
    <div class="tabs">
      <button class="tab active" onclick="setView('day',this)">日</button>
      <button class="tab" onclick="setView('week',this)">周</button>
      <button class="tab" onclick="setView('month',this)">月</button>
    </div>
    <div class="filter-wrap">
      <input type="date" class="date-input" id="dateFrom" onchange="loadData()" />
      <span class="date-sep">至</span>
      <input type="date" class="date-input" id="dateTo" onchange="loadData()" />
      <button class="date-reset" onclick="resetDates()">重置</button>
      <select class="sel" id="promoFilter" onchange="renderOverview()"><option value="all">全部 Promo</option></select>
    </div>
  </div>

  <div id="overviewContent">
    <div class="loading-state"><div class="spinner"></div>等待数据...</div>
  </div>
</div>

<!-- ── ANALYSIS PAGE ── -->
<div id="analysisPage" class="hidden">
  <div class="cur-toggle">
    <button class="cur-tab active" onclick="setAnalysisCur('MYR',this)">🇲🇾 MYR</button>
    <button class="cur-tab" onclick="setAnalysisCur('SGD',this)">🇸🇬 SGD</button>
    <button class="cur-tab" onclick="setAnalysisCur('ALL',this)">全部</button>
  </div>
  <div class="analysis-summary" id="analysisSummary"></div>
  <div style="margin-bottom:1rem;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.25rem;">
    <div style="font-size:0.75rem;color:var(--muted2);text-transform:uppercase;margin-bottom:0.75rem;">判断标准</div>
