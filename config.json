</style></head><body>
<button class="print-btn no-print" onclick="window.print()">🖨️ 打印 / 另存 PDF</button>
<div class="cover"><h1>PROMO</h1><h2>Performance Report</h2>
<div class="meta">${monthStr} &nbsp;|&nbsp; MYR & SGD</div>
<div class="meta" style="margin-top:8px">Prepared by: PROMO Department &nbsp;|&nbsp; ${new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'})}</div></div>
${myrRows.length?`<div class="divider"></div><div class="section"><div class="section-header">Monthly Overview — ${monthStr} (MYR)</div>${kpiCards(myrT,'MYR')}</div>${promoTable(myrPromos,'MYR')}<div class="section"><div class="section-header">Charts (MYR)</div><div class="chart-grid"><div class="chart-box"><h3>Claims by Promo (Top 8)</h3><canvas id="myrC1" height="220"></canvas></div><div class="chart-box"><h3>Deposit vs Bonus</h3><canvas id="myrC2" height="220"></canvas></div><div class="chart-box"><h3>Net Profit Ranking</h3><canvas id="myrC3" height="220"></canvas></div><div class="chart-box"><h3>Bonus Distribution</h3><canvas id="myrC4" height="220"></canvas></div></div></div>${recSection(myrPromos,'MYR')}`:''}
${sgdRows.length?`<div class="divider"></div><div class="section"><div class="section-header">Monthly Overview — ${monthStr} (SGD)</div>${kpiCards(sgdT,'SGD')}</div>${promoTable(sgdPromos,'SGD')}<div class="section"><div class="section-header">Charts (SGD)</div><div class="chart-grid"><div class="chart-box"><h3>Claims by Promo (Top 8)</h3><canvas id="sgdC1" height="220"></canvas></div><div class="chart-box"><h3>Deposit vs Bonus</h3><canvas id="sgdC2" height="220"></canvas></div><div class="chart-box"><h3>Net Profit Ranking</h3><canvas id="sgdC3" height="220"></canvas></div><div class="chart-box"><h3>Bonus Distribution</h3><canvas id="sgdC4" height="220"></canvas></div></div></div>${recSection(sgdPromos,'SGD')}`:''}
<div class="footer">PROMO Department &nbsp;|&nbsp; ${monthStr} &nbsp;|&nbsp; Confidential</div>
<script>
function mkCharts(promos,prefix,fmtFn){
  const top8=promos.slice(0,8),labels=top8.map(p=>p.name.length>18?p.name.slice(0,18)+'…':p.name),C=['#1A6BB5','#028090','#059669','#D97706','#7C3AED','#DB2777','#EA580C','#0891B2'];
  const opts={responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{font:{size:9},color:'#64748B'},grid:{display:false}},y:{ticks:{font:{size:9},color:'#64748B'},grid:{color:'#E2E8F0'}}}};
  new Chart(document.getElementById(prefix+'C1'),{type:'bar',data:{labels,datasets:[{data:top8.map(p=>p.claims),backgroundColor:C,borderRadius:3}]},options:{...opts}});
  new Chart(document.getElementById(prefix+'C2'),{type:'bar',data:{labels,datasets:[{label:'Deposit',data:top8.map(p=>p.deposit),backgroundColor:'#1A6BB5',borderRadius:2},{label:'Bonus',data:top8.map(p=>p.bonus),backgroundColor:'#D97706',borderRadius:2}]},options:{...opts,plugins:{legend:{position:'bottom',labels:{font:{size:9}}},tooltip:{mode:'index',intersect:false,callbacks:{label:c=>c.dataset.label+': '+fmtFn(c.parsed.y)}}},scales:{x:{ticks:{font:{size:9},color:'#64748B'},grid:{display:false}},y:{ticks:{font:{size:9},color:'#64748B',callback:v=>fmtFn(v)},grid:{color:'#E2E8F0'}}}}});
  const sortedNP=[...promos].sort((a,b)=>b.netProfit-a.netProfit).slice(0,8);
  new Chart(document.getElementById(prefix+'C3'),{type:'bar',data:{labels:sortedNP.map(p=>p.name.length>18?p.name.slice(0,18)+'…':p.name),datasets:[{data:sortedNP.map(p=>p.netProfit),backgroundColor:sortedNP.map(p=>p.netProfit>=0?'#059669':'#DC2626'),borderRadius:3}]},options:{...opts,indexAxis:'y',plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>'NP: '+fmtFn(c.parsed.x)}}},scales:{x:{ticks:{font:{size:9},color:'#64748B',callback:v=>fmtFn(v)},grid:{color:'#E2E8F0'}},y:{ticks:{font:{size:9},color:'#64748B'},grid:{display:false}}}}});
  new Chart(document.getElementById(prefix+'C4'),{type:'pie',data:{labels:top8.map(p=>p.name.length>16?p.name.slice(0,16)+'…':p.name),datasets:[{data:top8.map(p=>p.bonus),backgroundColor:C,borderWidth:1,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{font:{size:8},boxWidth:10}},tooltip:{callbacks:{label:c=>c.label+': '+fmtFn(c.parsed)}}}}});
}
${myrPromos.length?`mkCharts(${JSON.stringify(myrPromos.slice(0,8))},'myr',n=>{const abs=Math.abs(n);const s='RM'+abs.toLocaleString('en-MY',{minimumFractionDigits:2,maximumFractionDigits:2});return n<0?'('+s+')':s;});`:''}
${sgdPromos.length?`mkCharts(${JSON.stringify(sgdPromos.slice(0,8))},'sgd',n=>{const abs=Math.abs(n);const s='S$'+abs.toLocaleString('en-SG',{minimumFractionDigits:2,maximumFractionDigits:2});return n<0?'('+s+')':s;});`:''}
<\/script></body></html>`;
  const blob = new Blob([html], { type:'text/html' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=`PROMO_Report_${monthStr.replace(' ','_')}.html`; a.click();
  URL.revokeObjectURL(url);
  setTimeout(() => alert('✅ 报告已下载！\n打开 HTML 文件后点右下角「打印」→「另存为 PDF」'), 500);
}

// ── Comparison ──
let compCur = 'MYR';
function setCompCur(cur, btn) {
  compCur = cur;
  document.querySelectorAll('#comparisonPage .cur-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderComparison();
}
function renderComparison() {
  const rows = compCur === 'ALL' ? allDataFull : allDataFull.filter(r => r.currency === compCur);
  const fmt  = compCur === 'SGD' ? fmtSGD : fmtRM;
  const months = [...new Set(rows.map(r => r.date.slice(0,7)))].sort();
  if (months.length < 2) {
    document.getElementById('comparisonContent').innerHTML = '<div style="text-align:center;padding:3rem;color:var(--muted);font-size:0.85rem;">需要上传至少两个月的数据才能比较</div>';
    document.getElementById('compMonthTabs').innerHTML = ''; return;
  }
  const recentMonths = months.slice(-6);
  document.getElementById('compMonthTabs').innerHTML = recentMonths.map((m,i) =>
    `<button class="month-tab ${i===recentMonths.length-1?'active':''}" onclick="selectCompMonth('${m}',this)">${m}</button>`
  ).join('');
  renderCompMonths(recentMonths[recentMonths.length-1], recentMonths[recentMonths.length-2], rows, fmt);
}
function selectCompMonth(month, btn) {
  document.querySelectorAll('.month-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const rows = compCur === 'ALL' ? allDataFull : allDataFull.filter(r => r.currency === compCur);
  const fmt  = compCur === 'SGD' ? fmtSGD : fmtRM;
  const months = [...new Set(rows.map(r => r.date.slice(0,7)))].sort();
  const idx = months.indexOf(month);
  renderCompMonths(month, idx > 0 ? months[idx-1] : null, rows, fmt);
}
function renderCompMonths(curMonth, prevMonth, rows, fmt) {
  function calcMonth(m) {
    const r=rows.filter(r=>r.date.slice(0,7)===m);
    const bonus=r.reduce((s,x)=>s+x.bonus,0),wl=r.reduce((s,x)=>s+x.winloss,0),np=-wl-bonus;
    return { claims:r.length, depPpl:r.filter(x=>x.transfer>0).length, deposit:r.reduce((s,x)=>s+x.transfer,0), bonus, winloss:wl, netProfit:np, roi:bonus>0?np/bonus*100:null };
  }
  const cur=calcMonth(curMonth), prev=prevMonth?calcMonth(prevMonth):null;
  function chg(a,b) {
    if(!b||b===0)return'';
    const pct=((a-b)/Math.abs(b)*100).toFixed(1),up=a>=b;
    return `<span class="comparison-change ${up?'change-up':'change-down'}">${up?'▲':'▼'} ${Math.abs(pct)}%</span>`;
  }
  function row(label,curVal,prevVal,fmtFn,invertColor=false) {
    const curFmt=fmtFn(curVal),prevFmt=prevVal!==null?fmtFn(prevVal):'—',change=prevVal!==null?chg(curVal,prevVal):'';
    const curColor=invertColor?(curVal>=0?'var(--green)':'var(--red)'):'var(--text)';
    return `<div class="comparison-row"><div class="comparison-label">${label}</div>
      <div class="comparison-vals"><div class="comparison-val" style="color:var(--muted2)">${prevFmt}</div><div class="comparison-val" style="color:${curColor}">${curFmt}</div>${change}</div></div>`;
  }
  document.getElementById('comparisonContent').innerHTML = `
    <div style="display:flex;gap:8px;margin-bottom:1rem;font-size:0.75rem;">
      <span style="color:var(--muted2);min-width:200px;">指标</span>
      <span style="color:var(--muted);min-width:100px;text-align:right">${prevMonth||'—'}</span>
      <span style="color:var(--blue);min-width:100px;text-align:right">${curMonth}</span>
      <span style="color:var(--muted2)">变化</span>
    </div>
    <div class="comparison-card">
      ${row('领取人次',cur.claims,prev?.claims,fmtN)}
      ${row('存款人数',cur.depPpl,prev?.depPpl,fmtN)}
      ${row('总存款',cur.deposit,prev?.deposit,fmt)}
      ${row('派发 Bonus',cur.bonus,prev?.bonus,fmt)}
      ${row('Win/Loss',cur.winloss,prev?.winloss,fmt)}
      ${row('净利润',cur.netProfit,prev?.netProfit,fmt,true)}
      ${row('ROI',cur.roi||0,prev?.roi||0,v=>(v>=0?'+':'')+v.toFixed(1)+'%',true)}
    </div>`;
}

// ── Provider ──
let providerCur = 'MYR', providerChartInst = null;
function setProviderCur(cur, btn) {
  providerCur = cur;
  document.querySelectorAll('#providerPage .cur-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderProvider();
}
function renderProvider() {
  const rows = providerCur === 'ALL' ? allData : allData.filter(r => r.currency === providerCur);
  const fmt  = providerCur === 'SGD' ? fmtSGD : fmtRM;
  const map = {};
  rows.forEach(r => {
    const p=r.provider||'Unknown';
    if(!map[p])map[p]={name:p,claims:0,depPpl:0,deposit:0,bonus:0,winloss:0};
    map[p].claims++;map[p].depPpl+=r.transfer>0?1:0;map[p].deposit+=r.transfer;map[p].bonus+=r.bonus;map[p].winloss+=r.winloss;
  });
  const providers = Object.values(map).map(p=>({...p,netProfit:-p.winloss-p.bonus,roi:p.bonus>0?(-p.winloss-p.bonus)/p.bonus*100:null})).sort((a,b)=>b.claims-a.claims);
  document.getElementById('providerGrid').innerHTML = providers.slice(0,9).map(p => {
    const np=p.netProfit,npC=np>0?'var(--green)':'var(--red)';
    return `<div class="provider-card"><div class="provider-name">${p.name}</div>
      <div class="provider-stats">
        <span class="provider-stat">领取 <b style="color:var(--blue)">${fmtN(p.claims)}</b></span>
        <span class="provider-stat">净利润 <b style="color:${npC}">${np>=0?'+':''}${fmt(np)}</b></span>
        <span class="provider-stat">ROI <b style="color:${npC}">${p.roi!=null?(p.roi>=0?'+':'')+p.roi.toFixed(1)+'%':'—'}</b></span>
      </div></div>`;
  }).join('');
  if (providerChartInst) { providerChartInst.destroy(); providerChartInst=null; }
  const top10=[...providers].sort((a,b)=>b.netProfit-a.netProfit).slice(0,10);
  providerChartInst = new Chart(document.getElementById('providerChart'),{type:'bar',data:{labels:top10.map(p=>p.name),datasets:[{data:top10.map(p=>p.netProfit),backgroundColor:top10.map(p=>p.netProfit>=0?'rgba(0,229,160,0.8)':'rgba(255,61,90,0.8)'),borderRadius:4}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>'净利润: '+fmt(ctx.parsed.x)}}},scales:{x:{ticks:{font:{size:10,family:'Arial'},color:'#5A6A78',callback:v=>fmt(v)},grid:{color:'rgba(255,255,255,0.04)'},border:{color:'transparent'}},y:{ticks:{font:{size:10,family:'Arial'},color:'#8A9BAA'},grid:{display:false},border:{color:'transparent'}}}}});
  document.getElementById('providerTableBody').innerHTML = providers.map((p,i)=>{
    const np=p.netProfit,npC=np>0?'var(--green)':np<0?'var(--red)':'var(--muted)',roi=p.roi!=null?(p.roi>=0?'+':'')+p.roi.toFixed(1)+'%':'—';
    return `<tr><td>${p.name}</td><td class="myr-v">${fmtN(p.claims)}</td><td class="myr-v">${fmtN(p.depPpl)}</td><td style="text-align:right;color:var(--green)">${fmt(p.deposit)}</td><td style="text-align:right;color:var(--amber)">${fmt(p.bonus)}</td><td style="text-align:right;color:var(--muted2)">${fmt(p.winloss)}</td><td style="text-align:right;color:${npC};font-weight:bold">${np>=0?'+':''}${fmt(np)}</td><td style="text-align:right;color:${npC};font-weight:bold">${roi}</td></tr>`;
  }).join('');
}

// ── Daily Mission CSV Parser ──
function parseMissionFrontend(text) {
  text = text.replace(/^\uFEFF/, '');
  const lines = text.trim().split('\n');
  const headers = lines[0].split(',').map(h => h.replace(/"/g,'').trim());
  const idx = h => headers.findIndex(hh => hh === h);
  const iId=idx('id'), iMerchant=idx('merchantCode'), iLogin=idx('memberLogin'), iGroup=idx('memberGroup');
  const iCur=idx('currency'), iCat=idx('missionCategory'), iName=idx('missionName'), iDay=idx('dayNo');
  const iDep=idx('depositAmount'), iBet=idx('validBet'), iBonus=idx('bonus'), iPoint=idx('activityPoint');
  const iTurnover=idx('targetTurnover'), iComplDate=idx('completedDate'), iComplAt=idx('completedDateTime');
  const iClaimAt=idx('claimDateTime'), iExpiry=idx('expiryDateTime'), iStatus=idx('status'), iSetting=idx('missionSettingId');
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const r = lines[i].split(',').map(c => c.replace(/"/g,'').trim());
    if (!r || r.length < 5) continue;
    const login = r[iLogin]?.trim(); if (!login) continue;
    rows.push({
      id: parseInt(r[iId])||null, merchant_code:r[iMerchant]||'', member_login:login,
      member_group:r[iGroup]||'', currency:r[iCur]||'', mission_category:r[iCat]||'',
      mission_name:r[iName]||'', day_no:parseInt(r[iDay])||1,
      deposit_amount:parseFloat(r[iDep])||0, valid_bet:parseFloat(r[iBet])||0,
      bonus:parseFloat(r[iBonus])||0, activity_point:parseFloat(r[iPoint])||0,
      target_turnover:parseFloat(r[iTurnover])||0,
      completed_date:r[iComplDate]||null, completed_at:r[iComplAt]||null,
      claimed_at:r[iClaimAt]||null, expiry_at:r[iExpiry]||null,
      status:r[iStatus]||'', mission_setting_id:parseInt(r[iSetting])||null,
    });
  }
  return rows;
}

// ── Upload Daily Mission ──
async function uploadMission(input) {
  const file = input.files[0]; if (!file) return;
  const btn = document.getElementById('btnMission');
  btn.className = 'upload-btn uploading';
  setStatus('', '解析中...');
  try {
    const text = await file.text();
    const rows = parseMissionFrontend(text);
    if (!rows.length) throw new Error('找不到有效数据');
    const dates = rows.map(r=>(r.completed_date||'').slice(0,10)).filter(Boolean).sort();
    const minDate = dates[0], maxDate = dates[dates.length-1];
    const batchSize = 500;
    let totalInserted = 0;
    for (let i = 0; i < rows.length; i += batchSize) {
      const batch = rows.slice(i, i + batchSize);
      setStatus('', `上传中... ${i+batch.length}/${rows.length}`);
      const res = await fetch(API + '/upload-mission', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows: batch, minDate, maxDate, isFirst: i === 0 })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);
      totalInserted += data.inserted;
    }
    btn.className = 'upload-btn done';
    btn.style.borderColor = 'var(--teal)'; btn.style.color = 'var(--teal)';
    btn.innerHTML = `<input type="file" accept=".csv" onchange="uploadMission(this)" /> ✅ Mission (${totalInserted})`;
    setStatus('live', `Daily Mission 上传成功 · ${totalInserted} 条`);
    if (minDate) document.getElementById('missionFrom').value = minDate;
    if (maxDate) document.getElementById('missionTo').value   = maxDate;
    if (!document.getElementById('missionPage').classList.contains('hidden')) await renderMission();
  } catch(e) {
    btn.className = 'upload-btn';
    setStatus('error', '上传失败: ' + e.message);
    alert('上传失败: ' + e.message);
  }
}

function resetMissionDates() {
  document.getElementById('missionFrom').value = '';
  document.getElementById('missionTo').value   = '';
  renderMission();
}

// ── Daily Mission Render ──
async function renderMission() {
  const from = document.getElementById('missionFrom').value;
  const to   = document.getElementById('missionTo').value;
  document.getElementById('missionContent').innerHTML = '<div class="loading-state"><div class="spinner"></div>加载中...</div>';
  try {
    let q = '/mission?'; if (from) q += 'from=' + from + '&'; if (to) q += 'to=' + to;
    const { byDay, summary, byGroup } = await apiFetch(q);
    if (!byDay || !byDay.length) {
      document.getElementById('missionContent').innerHTML = '<div style="text-align:center;padding:3rem;color:var(--muted);font-size:0.85rem;">暂无数据，请上传 Daily Mission CSV</div>';
      return;
    }

    const claimRate = summary.total_records > 0 ? (summary.total_claimed / summary.total_records * 100).toFixed(1) : 0;
    const kpiHTML = `<div class="mission-kpi">
      <div class="metric teal-card"><div class="lbl">参与玩家</div><div class="val" style="color:var(--teal)">${fmtN(summary.total_players)}</div></div>
      <div class="metric teal-card"><div class="lbl">最高连续天数</div><div class="val" style="color:var(--teal)">${summary.max_day} 天</div></div>
      <div class="metric teal-card"><div class="lbl">总领取次数</div><div class="val" style="color:var(--teal)">${fmtN(summary.total_claimed)}</div><div class="sub">领取率: ${claimRate}%</div></div>
      <div class="metric teal-card"><div class="lbl">总过期次数</div><div class="val" style="color:var(--red)">${fmtN(summary.total_expired)}</div><div class="sub">完成但未领取</div></div>
      <div class="metric teal-card"><div class="lbl">总派发 Bonus</div><div class="val" style="color:var(--teal)">${fmtRM(summary.total_bonus)}</div></div>
      <div class="metric teal-card"><div class="lbl">总积分派发</div><div class="val" style="color:var(--teal)">${fmtN(Math.round(summary.total_points))}</div></div>
    </div>`;

    const groupOrder = ['BRONZE','SILVER','GOLD','PLATINUM','DIAMOND'];
    const groupColors = { BRONZE:'#CD7F32', SILVER:'#C0C0C0', GOLD:'#FFD700', PLATINUM:'#E5E4E2', DIAMOND:'#B9F2FF' };
    const sortedGroups = [...byGroup].sort((a,b) => (groupOrder.indexOf(a.group)||99) - (groupOrder.indexOf(b.group)||99));
    const groupHTML = `<div class="mission-group-grid">${sortedGroups.map(g => {
      const color = groupColors[g.group] || 'var(--teal)';
      const rate = (g.claimed + g.expired) > 0 ? (g.claimed / (g.claimed + g.expired) * 100).toFixed(1) : 0;
      return `<div class="mission-group-card" style="border-top:3px solid ${color};">
        <div class="mission-group-name" style="color:${color};">${g.group}</div>
        <div class="mission-group-val" style="color:${color};">${fmtN(g.unique_players)}</div>
        <div class="mission-group-sub">领取: ${fmtN(g.claimed)} | 过期: ${fmtN(g.expired)}</div>
        <div class="mission-group-sub">领取率: ${rate}%</div>
        <div class="mission-group-sub">Bonus: ${fmtRM(g.bonus)}</div>
      </div>`;
    }).join('')}</div>`;

    const chartHTML = `<div class="chart-card" style="margin-bottom:14px;">
      <div class="chart-hd"><div class="chart-title">每日任务领取 vs 过期（前30天）</div>
        <div class="legend"><span><span class="leg" style="background:var(--teal)"></span>已领取</span><span><span class="leg" style="background:var(--red);opacity:0.7"></span>已过期</span></div>
      </div>
      <div style="position:relative;width:100%;height:280px;"><canvas id="missionChart"></canvas></div>
    </div>`;

    const day1Claimed = byDay[0]?.claimed || 1;
    const showDays = byDay.slice(0, 30);
    const funnelRows = showDays.map(d => {
      const total = d.claimed + d.expired;
      const claimedPct = total > 0 ? d.claimed / total * 100 : 0;
      const expiredPct = total > 0 ? d.expired / total * 100 : 0;
      const dropPct = d.day_no > 1 ? ((d.claimed / day1Claimed) * 100).toFixed(1) + '%' : 'Day 1';
      return `<div class="mission-day-row">
        <div class="mission-day-label">Day ${d.day_no}</div>
        <div class="mission-bar-wrap">
          <div class="mission-bar-claimed" style="width:${claimedPct}%"></div>
          <div class="mission-bar-expired" style="left:${claimedPct}%;width:${expiredPct}%"></div>
        </div>
        <div class="mission-bar-label"><span style="color:var(--teal)">✅ ${fmtN(d.claimed)}</span> &nbsp; <span style="color:var(--red)">❌ ${fmtN(d.expired)}</span></div>
        <div class="mission-stat-cell" style="color:var(--muted2)">${dropPct}</div>
        <div class="mission-stat-cell">${fmtRM(d.bonus)}</div>
        <div class="mission-stat-cell">${fmtN(Math.round(d.activity_point))}</div>
      </div>`;
    }).join('');

    const funnelHTML = `<div class="mission-funnel">
      <div class="mission-funnel-hd">
        <div class="mission-funnel-title">📊 每日任务漏斗（前30天）</div>
      </div>
      <div style="display:grid;grid-template-columns:80px 1fr 1fr 100px 110px 110px;padding:8px 1.4rem;border-bottom:1px solid var(--border);">
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;">天数</div>
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;">比例</div>
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;">人数</div>
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;text-align:right;">vs Day1</div>
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;text-align:right;">Bonus</div>
        <div style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;text-align:right;">积分</div>
      </div>
      ${funnelRows}
    </div>`;

    const fullTableHTML = byDay.length > 30 ? `<div class="table-card">
      <div class="table-hd">完整数据 — 全部 ${byDay.length} 天</div>
      <div class="table-wrap"><table>
        <thead><tr><th>天数</th><th>已领取</th><th>已过期</th><th>合计</th><th>Bonus</th><th>积分</th><th>要求存款</th><th>要求流水</th></tr></thead>
        <tbody>${byDay.map(d=>`<tr>
          <td style="color:var(--teal);font-weight:700;">Day ${d.day_no}</td>
          <td style="color:var(--teal)">${fmtN(d.claimed)}</td>
          <td style="color:var(--red)">${fmtN(d.expired)}</td>
          <td>${fmtN(d.total)}</td>
          <td>${fmtRM(d.bonus)}</td>
          <td>${fmtN(Math.round(d.activity_point))}</td>
          <td>${fmtRM(d.deposit_amount)}</td>
          <td>${fmtRM(d.valid_bet)}</td>
        </tr>`).join('')}</tbody>
      </table></div>
    </div>` : '';

    document.getElementById('missionContent').innerHTML = kpiHTML + groupHTML + chartHTML + funnelHTML + fullTableHTML;

    if (missionChartInst) { missionChartInst.destroy(); missionChartInst = null; }
    missionChartInst = new Chart(document.getElementById('missionChart'), {
      type: 'bar',
      data: {
        labels: showDays.map(d => 'Day '+d.day_no),
        datasets: [
          { label:'已领取', data:showDays.map(d=>d.claimed), backgroundColor:'rgba(0,201,255,0.75)', borderRadius:3 },
          { label:'已过期', data:showDays.map(d=>d.expired), backgroundColor:'rgba(255,61,90,0.6)',  borderRadius:3 },
        ]
      },
      options: {
        responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false}, tooltip:{mode:'index',intersect:false} },
        scales:{
          x:{ticks:{font:{size:10,family:'Arial'},color:'#5A6A78'},grid:{display:false},border:{color:'transparent'}},
          y:{ticks:{font:{size:10,family:'Arial'},color:'#5A6A78',callback:v=>fmtN(v)},grid:{color:'rgba(255,255,255,0.04)'},border:{color:'transparent'}}
        }
      }
    });
  } catch(e) {
    document.getElementById('missionContent').innerHTML = `<div style="text-align:center;padding:3rem;color:var(--red)">加载失败: ${e.message}</div>`;
  }
}

// Start
init();
</script>
</body>
</html>
