  </div>
  <div class="analysis-grid" id="analysisGrid"></div>
  <div class="chart-card">
    <div class="chart-hd"><div class="chart-title">净利润排名</div></div>
    <div style="position:relative;width:100%;height:350px;"><canvas id="analysisChart"></canvas></div>
  </div>
</div>

<!-- ── PLAYER PAGE ── -->
<div id="playerPage" class="hidden">
  <div class="player-search">
    <input type="text" class="player-input" id="playerInput" placeholder="输入玩家账号（Login），按 Enter 搜索" onkeydown="if(event.key==='Enter')searchPlayer()" />
    <button class="search-btn" onclick="searchPlayer()">🔍 搜索</button>
  </div>
  <div id="playerContent">
    <div style="text-align:center;padding:3rem;color:var(--muted);font-size:0.85rem;">输入玩家账号来查看他的领取记录和行为分析</div>
  </div>
</div>

<!-- ── BUILDER PAGE ── -->
<div id="builderPage" class="hidden">
  <div class="builder-layout">
    <div class="builder-panel">
      <h3>🎨 图表构建器</h3>
      <div class="field-group">
        <label>货币</label>
        <select id="bCurrency"><option value="MYR">🇲🇾 MYR</option><option value="SGD">🇸🇬 SGD</option><option value="ALL">全部</option></select>
      </div>
      <div class="field-group">
        <label>X 轴 / 分组</label>
        <select id="bXAxis">
          <option value="date_day">按日期（日）</option>
          <option value="date_week">按日期（周）</option>
          <option value="date_month">按日期（月）</option>
          <option value="promo">按 Promo 名称</option>
